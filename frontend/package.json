{
  "name": "skillcoach-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-mediapipe": "node -e \"require('fs').cpSync('node_modules/@mediapipe/tasks-vision/wasm','public/mediapipe/wasm',{recursive:true})\"",
    "predev": "npm run copy-mediapipe",
    "prebuild": "npm run copy-mediapipe",
    "dev": "next dev -p 3000",
    "dev:mock": "cross-env NEXT_PUBLIC_MOCK=true next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "@pixiv/three-vrm": "^3.4.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
