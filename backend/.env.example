# Copy to backend/.env for local development. Never commit .env.

# Gemini via Vertex AI (Application Default Credentials).
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=project-6d34f8a9-8150-4e6a-ae7
# Gemini 3.x models are served from the global endpoint only.
GOOGLE_CLOUD_LOCATION=global
# Only when GOOGLE_GENAI_USE_VERTEXAI=false (AI Studio key).
GEMINI_API_KEY=

GEMINI_FAST_MODEL=gemini-3.8-flash
# Fallback if the preview is unavailable: gemini-2.5-pro
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Same region as Cloud Run; vectors are identical across regions.
GEMINI_EMBED_LOCATION=asia-east1
EMBED_DIMENSIONS=768

# memory | firestore
STORE_BACKEND=memory
# Optional named Firestore database (defaults to "(default)").
FIRESTORE_DATABASE=

CORS_ORIGINS=*

# true = canned LLM output and hash embeddings; no Google Cloud needed.
LLM_FAKE=false

# Local only: path to your ADC file (on Cloud Run the service account is used).
# GOOGLE_APPLICATION_CREDENTIALS=
