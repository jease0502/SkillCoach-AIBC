# Copy to backend/.env for local development. Never commit .env.

# Gemini via Vertex AI (Application Default Credentials).
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Gemini 3.x models are served from the global endpoint only.
GOOGLE_CLOUD_LOCATION=global
# Only when GOOGLE_GENAI_USE_VERTEXAI=false (AI Studio key).
GEMINI_API_KEY=

# gemini-4-argon is served from location=global only.
GEMINI_FAST_MODEL=gemini-4-argon
GEMINI_PRO_MODEL=gemini-4-argon
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# Tried in order on 404/429/5xx/timeout; a failed model is skipped for GEMINI_COOLDOWN_SECONDS.
GEMINI_FAST_FALLBACKS=gemini-3.8-flash
GEMINI_PRO_FALLBACKS=gemini-3.1-pro-preview,gemini-2.5-pro
GEMINI_LITE_FALLBACKS=gemini-3.8-flash
GEMINI_COOLDOWN_SECONDS=60
GEMINI_TIMEOUT_SECONDS=90
GEMINI_FIRST_CHUNK_TIMEOUT_SECONDS=20
GEMINI_EMBED_MODEL=gemini-embedding-001
# Same region as Cloud Run; vectors are identical across regions.
GEMINI_EMBED_LOCATION=asia-east1
EMBED_DIMENSIONS=768

# memory | firestore
STORE_BACKEND=memory
# Optional named Firestore database (defaults to "(default)").
FIRESTORE_DATABASE=

CORS_ORIGINS=*

# true = canned LLM output and hash embeddings; no Google Cloud needed.
LLM_FAKE=false

# Local only: path to your ADC file (on Cloud Run the service account is used).
# GOOGLE_APPLICATION_CREDENTIALS=
